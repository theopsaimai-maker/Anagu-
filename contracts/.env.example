# Hyperledger Besu QBFT network profile (do NOT commit live secrets)
# Set only when running non-local tools; Remix deployment uses MetaMask directly.
BESU_RPC_URL=
BESU_GAS_PRICE=0
# Match your Besu genesis.json fork configuration (e.g., london, paris, shanghai)
BESU_EVM_VERSION=paris
# Never commit a real private key
BESU_DEPLOYER_PRIVATE_KEY=
