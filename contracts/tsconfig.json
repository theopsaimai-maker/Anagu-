{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist"
  },
  "include": ["./hardhat.config.ts", "./test/**/*.ts", "./scripts/**/*.ts"],
  "exclude": ["node_modules", "artifacts", "cache", "dist"]
}
