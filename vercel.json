{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "^(.*[.-])?admin\\..*$" }],
      "destination": "/admin.html"
    },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" }
  ]
}

